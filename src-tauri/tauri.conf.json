{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run ng build",
    "beforeDevCommand": "npm run ng serve -- --port 4280",
    "devUrl": "http://localhost:4280",
    "frontendDist": "../dist"
  },
  "identifier": "org.webosbrew.devman",
  "productName": "webOS Dev Manager",
  "version": "../package.json",
  "app": {
    "security": {
      "csp": null,
      "devCsp": "default-src 'self' localhost"
    },
    "windows": [
      {
        "dragDropEnabled": false,
        "fullscreen": false,
        "height": 720,
        "label": "main",
        "minHeight": 600,
        "minWidth": 420,
        "resizable": true,
        "title": "webOS Dev Manager",
        "visible": true,
        "width": 1024
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": ".*"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "licenseFile": "../LICENSE",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "longDescription": "Manage developer-mode or rooted LG webOS TVs from macOS. Install apps from Homebrew Channel and custom catalogs, manage files, use SSH terminals, and configure native macOS glass effects and themes.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "shortDescription": "Device/Dev Mode Manager for webOS TV",
    "targets": [
      "app",
      "dmg"
    ]
  }
}
